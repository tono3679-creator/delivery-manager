# --- データベース（サーバー専用。絶対に NEXT_PUBLIC_ を付けない）---
# 公開環境：Vercel の Storage から Neon を追加すると、DATABASE_URL と DATABASE_URL_UNPOOLED が自動で設定される
#   DATABASE_URL           接続プーラー経由（-pooler の付いたホスト）。アプリが使う
#   DATABASE_URL_UNPOOLED  プーラーを通さない接続。公開時のマイグレーションに使う
# ローカル：
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dm
# DATABASE_URL_UNPOOLED=

# --- 見本の会社のログイン用アカウント（公開環境では必須。12文字以上・README の既定値は不可）---
# 管理者・ドライバーの両方に使う。ローカルでは未設定なら README の既定値（demo-admin-2026 / demo-driver-2026）
# SEED_LOGIN_PASSWORD=
# 個別に変えるとき（任意）
# SEED_ADMIN_PASSWORD=
# SEED_DRIVER_PASSWORD=

# --- 期限切れデモの削除（Vercel Cron）。公開環境では必須（16文字以上のランダムな文字列）---
CRON_SECRET=

# --- デモ環境（任意）---
# 同時に存在できるデモ環境の数（既定 30。1環境あたり約 12MB）
# DEMO_MAX_ACTIVE=30
# 同じ接続元から1時間に作れるデモ環境の数（既定 30）
# DEMO_CREATE_LIMIT_PER_HOUR=30

# --- 地図（任意。未設定なら OpenStreetMap の公開タイル。利用者が多い本番では契約したタイル配信を指定）---
# NEXT_PUBLIC_MAP_TILE_URL=https://example.com/tiles/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; 地図データの出典
