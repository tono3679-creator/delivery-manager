# --- Supabase（Project Settings → API / Database）---
# ブラウザに公開してよい値
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# サーバー専用（絶対に NEXT_PUBLIC_ を付けない）
# Vercel からは接続プーラー（Transaction モード, ポート 6543）の接続文字列を使う
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# Seed 用（ログインアカウントの作成に使用。アプリ本体では使わない）
SUPABASE_SERVICE_ROLE_KEY=
# 期限切れデモの削除（Vercel Cron）用
CRON_SECRET=
# 同時に存在できるデモ環境の数（任意。既定 30。1環境あたり約 12MB）
# DEMO_MAX_ACTIVE=30

# --- 地図（任意。未設定なら OpenStreetMap の公開タイル。利用者が多い本番では契約したタイル配信を指定）---
# NEXT_PUBLIC_MAP_TILE_URL=https://example.com/tiles/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; 地図データの出典

# --- ローカル開発（Supabase を使わない場合）---
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=local
# NEXT_PUBLIC_REALTIME_ENABLED=false
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/dm
