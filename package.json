    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
